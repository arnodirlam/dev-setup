[no-cd]
image-to-html-file input: (_cmd "tesseract") (_file input)
  #!/usr/bin/env bash
  set -euo pipefail

  input="$1"
  lang="${IMAGE_LANG:-${PDF_LANG:-deu+eng}}"

  available_langs="$(tesseract --list-langs 2>/dev/null | tail -n +2)"
  IFS='+' read -ra requested_langs <<< "$lang"
  for requested_lang in "${requested_langs[@]}"; do
    if ! grep -Fxq "$requested_lang" <<< "$available_langs"; then
      echo "Missing Tesseract language data: $requested_lang" >&2
      echo "Install Homebrew formula: tesseract-lang" >&2
      exit 1
    fi
  done

  dir="$(dirname "$input")"
  base="$(basename "$input")"
  stem="$base"
  case "$stem" in
    *.*) stem="${stem%.*}" ;;
  esac
  out="$dir/${stem}.html"
  tmp="$out.tmp.$$"

  trap 'rm -f "$tmp"' EXIT
  echo "Writing: $out" >&2
  tesseract "$input" stdout --psm 6 -l "$lang" hocr > "$tmp"
  mv "$tmp" "$out"
  trap - EXIT

# Make the background of one image transparent using the top-left pixel; set IMAGE_TRANSPARENT_FUZZ=8%, IMAGE_TRANSPARENT_COLOR=white, or IMAGE_DESPECKLE_RADIUS=1.
[no-cd]
image-to-transparent-file input: (_cmd "magick") (_file input)
  #!/usr/bin/env bash
  set -euo pipefail

  input="$1"
  fuzz="${IMAGE_TRANSPARENT_FUZZ:-8%}"
  despeckle_radius="${IMAGE_DESPECKLE_RADIUS:-1}"

  dir="$(dirname "$input")"
  base="$(basename "$input")"
  stem="$base"
  case "$stem" in
    *.*) stem="${stem%.*}" ;;
  esac
  out="$dir/${stem}-transparent.png"
  tmp="$out.tmp.$$.png"

  background="${IMAGE_TRANSPARENT_COLOR:-}"
  if [[ -z "$background" ]]; then
    background="$(magick "$input" -format "%[pixel:p{0,0}]" info:)"
  fi

  trap 'rm -f "$tmp"' EXIT
  echo "Writing: $out" >&2
  if [[ "$despeckle_radius" == "0" ]]; then
    magick "$input" \
      -alpha set \
      -fuzz "$fuzz" \
      -transparent "$background" \
      "$tmp"
  else
    magick "$input" \
      -alpha set \
      -fuzz "$fuzz" \
      -transparent "$background" \
      -channel A \
      -morphology Open "Disk:$despeckle_radius" \
      +channel \
      "$tmp"
  fi
  mv "$tmp" "$out"
  trap - EXIT

# Concatenate input images into out.pdf beside the first image.
[no-cd]
images-to-pdf +inputs: (_cmd "magick")
  #!/usr/bin/env bash
  set -euo pipefail

  first="$1"

  for input in "$@"; do
    just -g _file "$input"
  done

  out="$(dirname "$first")/out.pdf"
  tmp="$out.tmp.$$.pdf"

  trap 'rm -f "$tmp"' EXIT
  echo "Writing: $out" >&2
  magick "$@" "$tmp"
  mv "$tmp" "$out"
  trap - EXIT
